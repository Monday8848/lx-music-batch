++  /** 是否为计费网络（热点、按流量计费的 WiFi 也会是 true） */
++  @ReactMethod(isBlockingSynchronousMethod = true)
++  public boolean isMetered() {
++    try {
++      ConnectivityManager cm = getManager();
++      return cm != null && cm.isActiveNetworkMetered();
++    } catch (Throwable e) {
++      return false;
++    }
++  }
++}
