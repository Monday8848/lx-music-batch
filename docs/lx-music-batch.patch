+import fs from 'node:fs'
+
+export default {
+  ExternalDirectoryPath: process.env.TEST_DOWNLOAD_DIR!,
+  read: async(filePath: string, length: number, position: number) => {
+    const fd = fs.openSync(filePath, 'r')
+    const buf = Buffer.alloc(length)
