+            disabled={!stats.error}
+          >
+            <Text size={12} color={theme['c-button-font']}>{t('download_retry_failed')}</Text>
+          </Button>
+          <Button
+            style={{ ...styles.headerBtn, backgroundColor: theme['c-button-background'] }}
+            onPress={handleRetryLyrics}
