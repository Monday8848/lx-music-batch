+  unlink,
+  writeFile,
+} from '@/utils/fs'
+import { scanFile, writeLyric, writeMetadata, writePic } from '@/utils/localMediaMetadata'
+import { requestStoragePermission } from '@/utils/tools'
+import {
+  cleanupDownloadLogs,
+  installCrashHandler,
+  setDownloadLogEnabled,
