+        toast(t('download_retry_lyric_partial', { ok: result.ok, fail: result.fail }))
+      } else {
+        toast(t('download_retry_lyric_done', { ok: result.ok }))
+      }
+    } catch (err: any) {
+      toast(String(err?.message ?? err))
